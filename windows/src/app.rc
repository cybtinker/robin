#include <windows.h>
#include "resource.h"
IDI_APP ICON "app.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"
VS_VERSION_INFO VERSIONINFO
FILEVERSION APP_VERSION_NUM
PRODUCTVERSION APP_VERSION_NUM
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Fledgling"
      VALUE "FileDescription", "Fledgling Live - live voice makeup"
      VALUE "FileVersion", APP_VERSION
      VALUE "ProductName", "Fledgling Live"
      VALUE "ProductVersion", APP_VERSION
      VALUE "OriginalFilename", "FledglingLive.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
